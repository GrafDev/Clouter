{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clouter",
  "version": "0.1.8",
  "identifier": "app.clouter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clouter",
        "width": 880,
        "height": 460,
        "minWidth": 640,
        "minHeight": 340
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "mimeType": "application/x-bittorrent",
        "name": "BitTorrent file",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  }
}